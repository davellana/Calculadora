<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg"

    >
    <TextView
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CALCULADORA"
        android:textAlignment="center"
        android:textSize="50sp"
        android:textStyle="bold"
        android:layout_marginBottom="100sp"
        android:fontFamily="sans-serif-medium"
        />
    <TextView
        android:id="@+id/txtprev"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textSize="20sp"
        android:layout_gravity="end"
        android:layout_marginRight="30dp"
        android:background="@color/bg"
        android:textColor="@color/txt"
        />
    <TextView
        android:id="@+id/edttxt1"
        android:padding="10dp"
        android:singleLine="true"
        android:layout_width="355dp"
        android:layout_height="60dp"
        android:gravity="end"
        android:layout_marginBottom="30sp"
        android:background="@color/white"
        />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="6"
        >
        <FrameLayout
            android:layout_columnSpan="3"/>
        <Button
            android:id="@+id/btn_ac"
            style="@style/Button3"
            android:text="AC"
            />
        <Button
            android:id="@+id/btn_msuma"
            android:text="M+"
            style="@style/Button2Disabled"
            />
        <Button
            android:id="@+id/btn_mrest"
            android:text="M-"
            style="@style/Button2Disabled"
            />
        <Button
            android:id="@+id/btn_mc"
            android:text="MC"
            style="@style/Button2Disabled"
            />
        <Button
            android:id="@+id/btn_mrms"
            style="@style/Button2"
            android:text="MS"
            />
        <Button
            android:id="@+id/btn_7"
            android:text="7"
            style="@style/Button1"
            />
        <Button
            android:id="@+id/btn_8"
            android:text="8"
            style="@style/Button1"
            />
        <Button
            android:id="@+id/btn_9"
            android:text="9"
            style="@style/Button1"
            />
        <Button
            android:id="@+id/btn_div"
            android:text="÷"
            style="@style/Button2"
            />
        <Button
            android:id="@+id/btn_4"
            android:text="4"
            style="@style/Button1"
            />
        <Button
            android:id="@+id/btn_5"
            android:text="5"
            style="@style/Button1"
            />
        <Button
            android:id="@+id/btn_6"
            android:text="6"
            style="@style/Button1"
            />
        <Button
            android:id="@+id/btn_mult"
            android:text="x"
            style="@style/Button2"
            /><Button
        android:id="@+id/btn_1"
        android:text="1"
        style="@style/Button1"
        /><Button
        android:id="@+id/btn_2"
        android:text="2"
        style="@style/Button1"
        />
        <Button
            android:id="@+id/btn_3"
            android:text="3"
            style="@style/Button1"
            />
        <Button
            android:id="@+id/btn_rest"
            android:text="-"
            style="@style/Button2"
            />
        <Button
            android:id="@+id/btn_coma"
            android:text="."
            style="@style/Button2"
            />
        <Button
            android:id="@+id/btn_0"
            android:text="0"
            style="@style/Button1"
            />

        <Button
            android:id="@+id/btn_eq"
            android:text="="
            style="@style/Button3"

            android:backgroundTint="@color/eql"

            />
        <Button
            android:id="@+id/btn_sum"
            android:text="+"
            style="@style/Button2"
            />





    </GridLayout>







</LinearLayout>

