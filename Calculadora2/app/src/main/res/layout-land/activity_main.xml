<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@color/bg"

    >

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_margin="10dp"
        >

        <TextView
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="CALCULADORA"
            android:layout_gravity="center"            android:textSize="40sp"
            android:textStyle="bold" />
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="6"
            >

            <TextView
                android:id="@+id/edttxt1"
                android:layout_width="280dp"
                android:singleLine="true"
                android:layout_height="40dp"
                android:layout_columnSpan="3"
                android:layout_gravity="center"
                android:background="@color/white"
                android:padding="3dp"
                android:gravity="end"
                />
            <Button
                android:id="@+id/btn_ac"
                style="@style/Button3"
                android:text="AC"
                android:layout_gravity="center"
                />
            <Button
                android:id="@+id/btn_msuma"
                android:text="M+"
                style="@style/Button2Disabled"
                />
            <Button
                android:id="@+id/btn_mrest"
                android:text="M-"
                style="@style/Button2Disabled"
                />
            <Button
                android:id="@+id/btn_mc"
                android:text="MC"
                style="@style/Button2Disabled"
                />
            <Button
                android:id="@+id/btn_mrms"
                style="@style/Button2"
                android:text="MS"
                />
            <Button
                android:id="@+id/btn_7"
                android:text="7"
                style="@style/Button1"
                />
            <Button
                android:id="@+id/btn_8"
                android:text="8"
                style="@style/Button1"
                />
            <Button
                android:id="@+id/btn_9"
                android:text="9"
                style="@style/Button1"
                />
            <Button
                android:id="@+id/btn_div"
                android:text="÷"
                style="@style/Button2"
                />
            <Button
                android:id="@+id/btn_4"
                android:text="4"
                style="@style/Button1"
                />
            <Button
                android:id="@+id/btn_5"
                android:text="5"
                style="@style/Button1"
                />
            <Button
                android:id="@+id/btn_6"
                android:text="6"
                style="@style/Button1"
                />
            <Button
                android:id="@+id/btn_mult"
                android:text="x"
                style="@style/Button2"
                /><Button
            android:id="@+id/btn_1"
            android:text="1"
            style="@style/Button1"
            /><Button
            android:id="@+id/btn_2"
            android:text="2"
            style="@style/Button1"
            />
            <Button
                android:id="@+id/btn_3"
                android:text="3"
                style="@style/Button1"
                />
            <Button
                android:id="@+id/btn_rest"
                android:text="-"
                style="@style/Button2"
                />
            <Button
                android:id="@+id/btn_coma"
                android:text="."
                style="@style/Button2"
                />
            <Button
                android:id="@+id/btn_0"
                android:text="0"
                style="@style/Button1"
                />

            <Button
                android:id="@+id/btn_eq"
                android:text="="
                style="@style/Button3"

                android:backgroundTint="@color/eql"

                />
            <Button
                android:id="@+id/btn_sum"
                android:text="+"
                style="@style/Button2"
                />
        </GridLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_margin="10dp"
        >
        <TextView
            android:id="@+id/txtmemoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="25sp"
            android:text="Memòria: "
            android:textStyle="bold"
            android:layout_marginTop="60dp"
            android:layout_gravity="start"
            android:background="@color/bg"
            android:textColor="@color/txt"
            />
        <TextView
            android:id="@+id/txtmemo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:layout_marginLeft="15dp"
            android:text="Sense valor"
            android:layout_gravity="start"
            android:background="@color/bg"
            android:textColor="@color/txt"
            />
        <TextView
            android:id="@+id/txtprevTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="25sp"
            android:text="Operació en curs: "
            android:layout_marginTop="30dp"
            android:layout_gravity="start"
            android:background="@color/bg"
            android:textStyle="bold"
            android:textColor="@color/txt"
            />
        <TextView
            android:id="@+id/txtprev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:layout_marginLeft="15dp"
            android:text=""
            android:layout_gravity="start"
            android:background="@color/bg"
            android:textColor="@color/txt"
            />


    </LinearLayout>










</LinearLayout>

